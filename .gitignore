instance/
# Turnus data store — tracked dataset JSON (schedule/stats/double_shifts) and
# Excel sources, but generated PNGs and source PDFs stay out of git. Lives at
# turnusdata/ (NOT under app/static/, which is served without authentication).
turnusdata/**/*.pdf
turnusdata/**/*.png
# PII files must never live under app/static (served without auth) — they
# belong in instance/protected/. These rules block accidental re-adds.
app/static/**/medlemsliste*.xlsx
app/static/**/ansinitet*.pdf
turnusdata/**/turnusplan_*.json.gz
turnusdata/**/strekliste_*.json.gz
# Strekliste review report: generated, read locally, never committed or served.
turnusdata/**/gjennomgang_*.html
# Status and lock of a background strekliste generation (strekliste_job.py).
turnusdata/**/.generering.*

nul
